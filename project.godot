; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Erlenfall"
config/description="A crafting RPG about rebuilding a mountain village."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.de.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="forward_plus"
