; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Erlenfall"
config/description="A crafting RPG about rebuilding a mountain village."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[input]

move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]}
look_left={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]}
look_right={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]}
look_up={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]}
look_down={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]}
jump={"deadzone":0.5,"events":[Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]}
sprint={"deadzone":0.5,"events":[Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":9)]}
toggle_camera={"deadzone":0.5,"events":[Object(InputEventKey,"device":-1,"physical_keycode":86), Object(InputEventJoypadButton,"device":-1,"button_index":3)]}
fast_forward_time={"deadzone":0.5,"events":[Object(InputEventKey,"device":-1,"physical_keycode":84), Object(InputEventJoypadButton,"device":-1,"button_index":10)]}

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.de.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="forward_plus"
